<?xml version="1.0" encoding="UTF-8"?>
<!--
  Querencia Desktop labwc configuration (labwc -C, see querencia-session).
  Installed as /etc/querencia/labwc/rc.xml (a conffile: local changes are
  kept on upgrades). Per user: copy /etc/querencia/labwc/ to
  ~/.config/querencia/labwc/ and edit the copy.

  Only what Querencia changes is listed; everything else keeps labwc's
  built-in defaults. labwc drops its default keybinds as soon as rc.xml has
  one <keybind> of its own, so <default /> loads them again first
  (labwc-config(5), "<keyboard><default />"). Without a <mouse> section
  labwc keeps its default mouse bindings.

  Execute runs the command without a shell, so the launcher is named by its
  absolute path.
-->
<labwc_config>
  <!-- Four workspaces like GNOME 2. popupTime="0": no labwc overlay, the
       panel's workspace switcher shows the change. -->
  <desktops number="4" popupTime="0" prefix="Arbeitsfläche" />

  <keyboard>
    <default />
    <!-- Print (Druck) opens the Querencia Screenshot chooser (screen,
         frame a window, select an area), Alt+Print starts the window
         capture directly (the window is framed with the mouse). Both open
         the editor afterwards. -->
    <keybind key="Print">
      <action name="Execute" command="/usr/libexec/querencia/querencia-screenshot-start" />
    </keybind>
    <keybind key="A-Print">
      <action name="Execute" command="/usr/libexec/querencia/querencia-screenshot-start --window" />
    </keybind>
    <!-- GNOME 2 (Metacity) workspace keys: Ctrl+Alt+Left/Right switches,
         with Shift the active window moves along. No wrap-around, like
         Metacity and the panel switcher. -->
    <keybind key="C-A-Left">
      <action name="GoToDesktop" to="left" wrap="no" />
    </keybind>
    <keybind key="C-A-Right">
      <action name="GoToDesktop" to="right" wrap="no" />
    </keybind>
    <keybind key="C-A-S-Left">
      <action name="SendToDesktop" to="left" follow="yes" wrap="no" />
    </keybind>
    <keybind key="C-A-S-Right">
      <action name="SendToDesktop" to="right" follow="yes" wrap="no" />
    </keybind>
    <!-- Querencia Sitzung (package querencia-sitzung): Ctrl+Alt+L locks the
         screen at once (ext-session-lock, as GNOME 2), Ctrl+Alt+Delete
         opens the session dialog (Abmelden, Bildschirm sperren, Neu
         starten, Herunterfahren). Without the package nothing happens. -->
    <keybind key="C-A-l">
      <action name="Execute" command="/usr/bin/querencia-sitzung --sperren --sofort" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Execute" command="/usr/bin/querencia-sitzung --dialog" />
    </keybind>
    <!-- Querencia Tastenkürzel (package querencia-shell): Super+? (Super+
         Umschalt+ß on the German keyboard; labwc compares the modifiers
         exactly, hence W-S-) shows all shortcuts. -->
    <keybind key="W-S-question">
      <action name="Execute" command="/usr/bin/querencia-kuerzel" />
    </keybind>
  </keyboard>

  <!-- Querencia Sitzung and its polkit agent: their dialogs open centred
       on the active output and stay out of the window list and Alt+Tab,
       like GNOME 2 dialogs. -->
  <windowRules>
    <windowRule identifier="org.querencia.Sitzung*" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <windowRule identifier="org.querencia.PolkitAgent*" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <!-- These programs embed their own window icon: the title bar shows it
         instead of the icon theme's guess (live default since 20.10.). -->
    <windowRule identifier="org.querencia.Einstellungen" iconPriority="client" />
    <windowRule identifier="querencia-einstellungen" iconPriority="client" />
    <windowRule identifier="org.querencia.Editor" iconPriority="client" />
    <windowRule identifier="querencia-editor" iconPriority="client" />
    <windowRule identifier="org.querencia.Systemmonitor" iconPriority="client" />
    <windowRule identifier="querencia-systemmonitor" iconPriority="client" />
  </windowRules>

  <!-- Alt+Tab: list ("classic") with icon, title and workspace, only on
       the output with the keyboard focus. Colours and sizes come from the
       theme Querencia-Klassisch (osd.*). As with Metacity only the windows
       of the current workspace are switched. -->
  <windowSwitcher preview="yes" outlines="yes" order="focus">
    <osd show="yes" style="classic" output="focused" />
    <fields>
      <field content="icon" width="6%" />
      <field content="title" width="70%" />
      <field content="workspace" width="24%" />
    </fields>
  </windowSwitcher>

  <!-- Window theme Querencia-Klassisch (package querencia-shell,
       /usr/share/themes/Querencia-Klassisch/labwc); icon theme Querencia
       (package querencia-symbole, /usr/share/icons/Querencia, inheriting
       from gnome-human and hicolor). Without the window theme labwc falls
       back to its built-in one; without the icon theme Querencia there is
       NO fallback (labwc 0.9.8 knows the inheritance only from its
       index.theme) and title bars stay without icons, so the session
       package depends on querencia-symbole. Fonts: DejaVu Sans 10, title
       and menu header bold (package fonts-dejavu). -->
  <theme>
    <name>Querencia-Klassisch</name>
    <icon>Querencia</icon>
    <font place="ActiveWindow">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
    </font>
    <font place="MenuHeader">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
    </font>
    <font place="MenuItem">
      <name>DejaVu Sans</name>
      <size>10</size>
    </font>
    <font place="OnScreenDisplay">
      <name>DejaVu Sans</name>
      <size>10</size>
    </font>
  </theme>
</labwc_config>
