# Beispiel für /etc/greetd/config.toml – NICHT automatisch installiert.
# Grafischer Greeter ReGreet in cage.
# ReGreet ist nicht in Ubuntu 26.04 enthalten und muss separat bereitgestellt
# werden; cage kommt aus Ubuntu (Paket cage).
[terminal]
vt = 7

[default_session]
command = "dbus-run-session cage -s -mlast -- regreet"
user = "_greetd"
